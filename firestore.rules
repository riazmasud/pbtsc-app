rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    function isAdmin() { return signedIn() && role() == 'admin'; }
    function isCoach() { return signedIn() && role() == 'coach'; }
    function isParent() { return signedIn() && role() == 'parent'; }
    function ownsCoachDoc(coachId) {
      return isCoach() &&
        get(/databases/$(database)/documents/coaches/$(coachId)).data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    match /players/{id} {
      allow read: if isAdmin() || isCoach() ||
        (isParent() && resource.data.parentId == request.auth.uid);
      allow write: if isAdmin();
    }

    match /coaches/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /practices/{id} {
      allow read: if signedIn();
      allow write: if isAdmin() || ownsCoachDoc(resource.data.coachId);
    }

    match /announcements/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /attendance/{id} {
      allow read: if isAdmin() ||
        (isCoach()) ||
        (isParent() && get(/databases/$(database)/documents/players/$(resource.data.playerId)).data.parentId == request.auth.uid);
      allow write: if isAdmin() || isCoach();
    }

    match /coachPayments/{id} {
      allow read: if isAdmin() || ownsCoachDoc(resource.data.coachId);
      allow write: if isAdmin();
    }
  }
}
